<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topo: a paper topo sheet for a sixteen-grey panel. Black line-art on white; the only fill
  that carries meaning is the light grey tint on public land: national forests, and any other
  federal, state or local land a pack records. Tribal land is outlined, not tinted: it is not
  public land. Region packs built by mapdata/ add ownership=usfs, land=public|tribal,
  fs_road, fs_trail and contour_ext. Plain OSM maps render too, with their parks' boundaries,
  but no ownership or contours.
-->
<rendertheme
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    map-background="#FFFFFF"
    map-background-outside="#FFFFFF"
    version="5"
    xmlns="http://mapsforge.org/renderTheme"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd"
>

    <!-- ================ FILLS ================ -->

    <rule e="way" k="natural" v="sea" zoom-min="0">
        <area fill="#B8B8B8" />
    </rule>

    <!-- Public land: the tint -->
    <rule e="way" k="ownership" v="usfs" zoom-min="8">
        <area fill="#E4E4E4" />
    </rule>
    <rule e="way" k="land" v="public" zoom-min="8">
        <area fill="#E4E4E4" />
    </rule>

    <rule e="way" k="building" v="*" zoom-min="15">
        <area fill="#BBBBBB" />
    </rule>

    <rule e="way" k="natural|landuse" v="water|basin|reservoir" zoom-min="0">
        <area fill="#B8B8B8" stroke="#333333" stroke-width="0.5" />
    </rule>
    <rule e="way" k="waterway" v="riverbank" zoom-min="0">
        <area fill="#B8B8B8" stroke="#333333" stroke-width="0.5" />
    </rule>

    <!-- ================ CONTOURS ================ -->

    <!-- Lines are scale="none" (see the trails), so each step in closer gets its own, heavier
      and darker line here; one hairline for every zoom read as a grey wash close in.
      Out to z15: 40 ft lines with every 200 ft the index. From z16: every 20 ft, with every
      100 ft the index (contour_index). Packs from before 20 ft lines carry no contour_index;
      their 200 ft lines stay the index there. -->
    <rule e="way" k="contour_ext" v="elevation_major" zoom-min="11" zoom-max="12">
        <line stroke="#555555" stroke-width="1.0" scale="none" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_minor" zoom-min="13" zoom-max="14">
        <line stroke="#8C8C8C" stroke-width="0.6" scale="none" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_major" zoom-min="13" zoom-max="14">
        <line stroke="#4A4A4A" stroke-width="1.1" scale="none" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_minor" zoom-min="15" zoom-max="15">
        <line stroke="#707070" stroke-width="0.8" scale="none" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_major" zoom-min="15" zoom-max="15">
        <line stroke="#3C3C3C" stroke-width="1.4" scale="none" />
    </rule>
    <rule e="way" k="contour_ext" v="*" zoom-min="16" zoom-max="16">
        <rule e="way" k="contour_index" v="~">
            <rule e="way" k="contour_ext" v="elevation_minor|elevation_fine">
                <line stroke="#6A6A6A" stroke-width="0.8" scale="none" />
            </rule>
        </rule>
    </rule>
    <rule e="way" k="contour_ext" v="*" zoom-min="17">
        <rule e="way" k="contour_index" v="~">
            <rule e="way" k="contour_ext" v="elevation_minor|elevation_fine">
                <line stroke="#5A5A5A" stroke-width="1.1" scale="none" />
            </rule>
        </rule>
    </rule>
    <rule e="way" k="contour_ext" v="*" zoom-min="16" zoom-max="16">
        <rule e="way" k="contour_index" v="yes">
            <line stroke="#333333" stroke-width="1.5" scale="none" />
        </rule>
        <rule e="way" k="contour_index" v="~">
            <rule e="way" k="contour_ext" v="elevation_major">
                <line stroke="#333333" stroke-width="1.5" scale="none" />
            </rule>
        </rule>
    </rule>
    <rule e="way" k="contour_ext" v="*" zoom-min="17">
        <rule e="way" k="contour_index" v="yes">
            <line stroke="#262626" stroke-width="2.0" scale="none" />
        </rule>
        <rule e="way" k="contour_index" v="~">
            <rule e="way" k="contour_ext" v="elevation_major">
                <line stroke="#262626" stroke-width="2.0" scale="none" />
            </rule>
        </rule>
    </rule>

    <!-- Lot lines on private land. Close in they would read as one more contour, so from z15
      each runs in a white casing that breaks the contours it crosses: a line laid on the
      sheet, not a line of the ground. -->
    <rule e="way" k="parcel" v="line" zoom-min="14" zoom-max="14">
        <line stroke="#707070" stroke-width="0.8" scale="none" />
    </rule>
    <rule e="way" k="parcel" v="line" zoom-min="15" zoom-max="16">
        <line stroke="#FFFFFF" stroke-width="3.2" scale="none" />
        <line stroke="#3A3A3A" stroke-width="1.2" scale="none" />
    </rule>
    <rule e="way" k="parcel" v="line" zoom-min="17">
        <line stroke="#FFFFFF" stroke-width="4.4" scale="none" />
        <line stroke="#222222" stroke-width="1.7" scale="none" />
    </rule>

    <!-- ================ WATER LINES ================ -->

    <rule e="way" k="waterway" v="river" zoom-min="8">
        <line stroke="#333333" stroke-width="1.4" scale="none" />
    </rule>
    <rule e="way" k="waterway" v="stream|canal|drain" zoom-min="12" zoom-max="15">
        <line stroke="#555555" stroke-width="0.6" stroke-dasharray="5,2" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="waterway" v="stream|canal|drain" zoom-min="16">
        <line stroke="#333333" stroke-width="1.1" stroke-dasharray="8,3" stroke-linecap="butt" scale="none" />
    </rule>

    <!-- ================ BOUNDARIES ================ -->

    <!-- Forest Service land edge: long dash, dot -->
    <!-- Drawn from the forest's own outline (ownership_edge), never from a pack's cut edge -->
    <rule e="way" k="ownership_edge" v="usfs" zoom-min="10" zoom-max="15">
        <line stroke="#444444" stroke-width="1.3" stroke-dasharray="9,4,2,4" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="ownership_edge" v="usfs" zoom-min="16">
        <line stroke="#222222" stroke-width="2.0" stroke-dasharray="13,5,3,5" stroke-linecap="butt" scale="none" />
    </rule>
    <!-- Other public land's edge: the same line as the forests' -->
    <rule e="way" k="land_edge" v="public" zoom-min="10" zoom-max="15">
        <line stroke="#444444" stroke-width="1.3" stroke-dasharray="9,4,2,4" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="land_edge" v="public" zoom-min="16">
        <line stroke="#222222" stroke-width="2.0" stroke-dasharray="13,5,3,5" stroke-linecap="butt" scale="none" />
    </rule>
    <!-- Tribal land's edge: long dash, two dots -->
    <rule e="way" k="land_edge" v="tribal" zoom-min="10" zoom-max="15">
        <line stroke="#333333" stroke-width="1.3" stroke-dasharray="9,3,2,3,2,3" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="land_edge" v="tribal" zoom-min="16">
        <line stroke="#222222" stroke-width="2.0" stroke-dasharray="13,4,3,4,3,4" stroke-linecap="butt" scale="none" />
    </rule>
    <!-- A national park or protected area as OpenStreetMap maps it, where no pack says more -->
    <rule e="way" k="boundary" v="national_park" zoom-min="9">
        <line stroke="#555555" stroke-width="1.0" stroke-dasharray="6,3" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="boundary|leisure" v="protected_area|nature_reserve" zoom-min="12">
        <line stroke="#888888" stroke-width="0.7" stroke-dasharray="4,3" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="boundary" v="administrative" zoom-min="0">
        <rule e="way" k="admin_level" v="2|4">
            <line stroke="#666666" stroke-width="0.8" stroke-dasharray="3,3" stroke-linecap="butt" scale="none" />
        </rule>
    </rule>

    <!-- ================ ROADS ================ -->

    <!-- Paved through-roads: cased, white centre -->
    <rule e="way" k="highway" v="motorway|trunk|primary|secondary|tertiary|motorway_link|trunk_link|primary_link|secondary_link|tertiary_link" zoom-min="9">
        <line stroke="#000000" stroke-width="2.8" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="highway" v="motorway|trunk|primary|secondary|tertiary|motorway_link|trunk_link|primary_link|secondary_link|tertiary_link" zoom-min="9">
        <line stroke="#FFFFFF" stroke-width="1.4" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="highway" v="unclassified|residential|living_street|road" zoom-min="12">
        <line stroke="#000000" stroke-width="1.2" scale="none" />
    </rule>
    <rule e="way" k="highway" v="service" zoom-min="14">
        <line stroke="#000000" stroke-width="0.7" scale="none" />
    </rule>

    <!-- Dirt: tracks and Forest Service roads, dashed -->
    <rule e="way" k="highway" v="track" zoom-min="12">
        <line stroke="#000000" stroke-width="1.1" stroke-dasharray="7,3" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="fs_road" v="*" zoom-min="11">
        <line stroke="#000000" stroke-width="1.4" stroke-dasharray="7,3" stroke-linecap="butt" scale="none" />
    </rule>

    <!-- ================ TRAILS ================ -->

    <rule e="way" k="highway" v="path|footway|bridleway|steps" zoom-min="13">
        <line stroke="#000000" stroke-width="0.9" stroke-dasharray="2.5,2" stroke-linecap="butt" scale="none" />
    </rule>
    <rule e="way" k="fs_trail" v="yes" zoom-min="12">
        <rule e="way" k="national" v="yes">
            <line stroke="#000000" stroke-width="1.6" stroke-dasharray="4,2" stroke-linecap="butt" scale="none" />
        </rule>
        <rule e="way" k="national" v="~">
            <line stroke="#000000" stroke-width="1.1" stroke-dasharray="3,2" stroke-linecap="butt" scale="none" />
        </rule>
    </rule>

    <!-- ================ LABELS ================ -->

    <rule e="way" k="contour_ext" v="elevation_major" zoom-min="13" zoom-max="15">
        <pathText fill="#333333" font-size="9" k="name" priority="1" stroke="#FFFFFF" stroke-width="2.0" />
    </rule>
    <rule e="way" k="contour_ext" v="*" zoom-min="16">
        <rule e="way" k="contour_index" v="yes">
            <pathText fill="#222222" font-size="10" k="name" priority="1" stroke="#FFFFFF" stroke-width="2.0" />
        </rule>
        <rule e="way" k="contour_index" v="~">
            <rule e="way" k="contour_ext" v="elevation_major">
                <pathText fill="#222222" font-size="10" k="name" priority="1" stroke="#FFFFFF" stroke-width="2.0" />
            </rule>
        </rule>
    </rule>

    <rule e="way" k="waterway" v="river" zoom-min="12">
        <pathText display="order" fill="#000000" font-size="13" font-style="italic" k="name"
            priority="20" stroke="#FFFFFF" stroke-width="2.0" dy="3" />
    </rule>
    <rule e="way" k="waterway" v="stream" zoom-min="15">
        <pathText display="order" fill="#333333" font-size="11" font-style="italic" k="name"
            priority="12" stroke="#FFFFFF" stroke-width="2.0" />
    </rule>

    <rule e="way" k="fs_road" v="*" zoom-min="13">
        <pathText fill="#000000" font-size="10" font-style="bold" k="ref" priority="25"
            stroke="#FFFFFF" stroke-width="2.5" />
    </rule>
    <rule e="way" k="highway" v="primary|secondary|tertiary|unclassified|residential|track" zoom-min="14">
        <pathText fill="#000000" font-size="10" k="name" priority="15" stroke="#FFFFFF" stroke-width="2.0" />
    </rule>
    <rule e="way" k="fs_trail" v="yes" zoom-min="13">
        <pathText fill="#000000" font-size="11" font-style="italic" k="name" priority="30"
            stroke="#FFFFFF" stroke-width="2.5" />
    </rule>
    <rule e="way" k="highway" v="path|footway|bridleway" zoom-min="15">
        <pathText fill="#000000" font-size="10" font-style="italic" k="name" priority="10"
            stroke="#FFFFFF" stroke-width="2.0" />
    </rule>

    <!-- Public and tribal land's names, quietly -->
    <rule e="way" k="land" v="public|tribal" zoom-min="11">
        <caption fill="#333333" font-size="12" font-style="italic" k="name" priority="4"
            stroke="#FFFFFF" stroke-width="2.0" />
    </rule>

    <!-- Forest names, quietly, across the tint -->
    <rule e="way" k="ownership" v="usfs" zoom-min="10">
        <caption fill="#333333" font-size="12" font-style="italic" k="name" priority="5"
            stroke="#FFFFFF" stroke-width="2.0" />
    </rule>

    <rule e="node" k="place" v="city|town" zoom-min="9">
        <caption fill="#000000" font-size="15" font-style="bold" k="name" priority="60"
            stroke="#FFFFFF" stroke-width="2.5" />
    </rule>
    <rule e="node" k="place" v="village|hamlet|locality" zoom-min="13">
        <caption fill="#000000" font-size="12" k="name" priority="40" stroke="#FFFFFF" stroke-width="2.0" />
    </rule>

    <rule e="node" k="natural" v="peak" zoom-min="11">
        <symbol id="peak" src="@drawable/triangle#000000!" symbol-height="10" symbol-width="10" />
        <caption fill="#000000" font-size="11" font-style="bold" k="name" position="above" priority="40"
            stroke="#FFFFFF" stroke-width="2.0" symbol-id="peak" />
        <rule e="any" k="trail_sense_peak_elevation" v="yes" zoom-min="13">
            <caption fill="#000000" font-size="10" k="ele" position="below" priority="30"
                stroke="#FFFFFF" stroke-width="2.0" symbol-id="peak" />
        </rule>
    </rule>
    <rule e="node" k="mountain_pass" v="yes" zoom-min="13">
        <caption fill="#000000" font-size="10" font-style="italic" k="name" priority="20"
            stroke="#FFFFFF" stroke-width="2.0" />
    </rule>
</rendertheme>
