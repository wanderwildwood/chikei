<?xml version="1.0" encoding="utf-8"?>
<!-- A selection handle that reads on white and on black: black with a white rim. The handles are
     windows of their own that dark mode's filter does not reach, so they must show on both. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="22"
    android:viewportHeight="22">
    <path
        android:fillColor="#000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:pathData="M1,1 H11 A10,10 0 1,1 1,11 Z" />
</vector>
