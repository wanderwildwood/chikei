<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"
        app:title="@string/maps">

        <ListPreference
            app:defaultValue="automatic"
            app:entries="@array/topo_map_source_entries"
            app:entryValues="@array/topo_map_source_values"
            app:iconSpaceReserved="false"
            app:key="@string/pref_topo_map_source"
            app:singleLineTitle="false"
            app:title="@string/map_source"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:summary="@string/saved_areas_summary"
            app:iconSpaceReserved="false"
            app:key="@string/pref_saved_areas"
            app:singleLineTitle="false"
            app:title="@string/saved_areas" />

        <SwitchPreferenceCompat
            android:title="@string/pref_navigation_lock_screen_when_open_title"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="@string/pref_map_keep_unlocked"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:title="@string/remember_map_state"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="@string/pref_save_map_state"
            app:singleLineTitle="false" />

        <ListPreference
            app:defaultValue="normal"
            app:entries="@array/compass_update_frequency_entries"
            app:entryValues="@array/compass_update_frequency_values"
            app:iconSpaceReserved="false"
            app:key="@string/pref_map_compass_update_frequency"
            app:singleLineTitle="false"
            app:title="@string/compass_update_frequency"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:summary="@string/pref_high_detail_mode_summary"
            android:title="@string/pref_high_detail_mode_title"
            app:defaultValue="true"
            app:iconSpaceReserved="true"
            app:key="@string/pref_map_high_detail_mode"
            app:singleLineTitle="false" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="@string/pref_map_layer_button"
            app:singleLineTitle="false"
            app:title="@string/layers" />
    </PreferenceCategory>
</PreferenceScreen>
