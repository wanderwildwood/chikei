<resources>

    <!--This is used for all Android versions-->
    <style name="BaseAppTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <!-- Mudita Mindful Design's typeface, applied through the whole Material type scale -->
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Topo.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Topo.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Topo.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Topo.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Topo.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Topo.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Topo.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Topo.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Topo.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Topo.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Topo.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Topo.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Topo.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Topo.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Topo.LabelSmall</item>
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>
        <item name="colorPrimaryFixed">@color/md_theme_primaryFixed</item>
        <item name="colorOnPrimaryFixed">@color/md_theme_onPrimaryFixed</item>
        <item name="colorPrimaryFixedDim">@color/md_theme_primaryFixedDim</item>
        <item name="colorOnPrimaryFixedVariant">@color/md_theme_onPrimaryFixedVariant</item>
        <item name="colorSecondaryFixed">@color/md_theme_secondaryFixed</item>
        <item name="colorOnSecondaryFixed">@color/md_theme_onSecondaryFixed</item>
        <item name="colorSecondaryFixedDim">@color/md_theme_secondaryFixedDim</item>
        <item name="colorOnSecondaryFixedVariant">@color/md_theme_onSecondaryFixedVariant</item>
        <item name="colorTertiaryFixed">@color/md_theme_tertiaryFixed</item>
        <item name="colorOnTertiaryFixed">@color/md_theme_onTertiaryFixed</item>
        <item name="colorTertiaryFixedDim">@color/md_theme_tertiaryFixedDim</item>
        <item name="colorOnTertiaryFixedVariant">@color/md_theme_onTertiaryFixedVariant</item>
        <item name="colorSurfaceDim">@color/md_theme_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>

        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>
        <!-- MMD, carried to views: white containers with black edges, 8dp corners, no shadow,
             nothing animating in or out -->
        <item name="materialCardViewStyle">@style/Widget.Topo.Card</item>
        <item name="materialButtonStyle">@style/Widget.Topo.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Topo.Button.Outlined</item>
        <item name="floatingActionButtonStyle">@style/Widget.Topo.FloatingActionButton</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.Topo.ExtendedFloatingActionButton</item>
        <item name="bottomNavigationStyle">@style/Widget.Topo.BottomNavigation</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="quickActionButtonStyle">@style/Widget.App.QuickActionButton</item>
        <item name="preferenceTheme">@style/AppThemePreferenceThemeOverlay</item>
    </style>

    <style name="WidgetTheme" parent="Theme.Material3Expressive.DynamicColors.DayNight" />

    <style name="WidgetTheme.TransparentBase" parent="Theme.Material3Expressive.DynamicColors.DayNight">
        <item name="colorSurfaceContainer">@android:color/transparent</item>
        <!--This is the color used for the sun/moon chart-->
        <item name="android:colorBackground">@color/colorSecondary</item>
    </style>

    <style name="WidgetTheme.TransparentWhite.TextView" parent="@android:style/Widget.TextView">
        <item name="android:shadowColor">@android:color/black</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetTheme.TransparentBlack.TextView" parent="@android:style/Widget.TextView">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetTheme.TransparentBlack" parent="WidgetTheme.TransparentBase">
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:textViewStyle">@style/WidgetTheme.TransparentBlack.TextView</item>
    </style>

    <style name="WidgetTheme.TransparentWhite" parent="WidgetTheme.TransparentBase">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="android:textViewStyle">@style/WidgetTheme.TransparentWhite.TextView</item>
    </style>


    <!--Override this for other Android versions-->
    <style name="AppTheme" parent="BaseAppTheme" />

    <style name="TextAppearance.Topo.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>
    <style name="TextAppearance.Topo.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
    </style>

    <style name="Theme.Transparent" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- A bottom sheet like the house dialog: no dimmed backdrop, no slide, a black rim -->
    <style name="AppBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppBottomSheetModalStyle</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="AppBottomSheetModalStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/eink_sheet_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="dialogCornerRadius">12dp</item>
        <item name="android:windowBackground">@drawable/eink_dialog_background</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="backgroundTint">@android:color/white</item>
    </style>

    <style name="Widget.App.QuickActionButton" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="backgroundTint">@android:color/white</item>
        <item name="iconTint">@android:color/black</item>
        <item name="strokeColor">@android:color/black</item>
        <item name="strokeWidth">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Topo.Small</item>
    </style>

    <style name="Widget.App.MapButton" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="backgroundTint">@android:color/white</item>
        <item name="iconTint">@android:color/black</item>
        <item name="strokeColor">@android:color/black</item>
        <item name="strokeWidth">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Topo.Small</item>
    </style>

    <style name="AppTheme.ListViewWithFab">
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingBottom">96dp</item>
    </style>

    <style name="AppThemePreferenceThemeOverlay" parent="@style/PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/SwitchPreferenceStyle</item>
        <item name="preferenceFragmentCompatStyle">@style/Topo.PreferenceFragment</item>
    </style>

    <!-- A settings screen gets the house top bar; see SettingsChrome -->
    <style name="Topo.PreferenceFragment" parent="@style/PreferenceFragment.Material">
        <item name="android:layout">@layout/preference_fragment_topo</item>
    </style>

    <style name="SwitchPreferenceStyle" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preference_material_switch</item>
    </style>

    <style name="Widget.App.SearchTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeColor">@color/topo_box_stroke</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Topo.Small</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.App.SearchTextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>


    <!-- MMD's measures (mmd-core): buttons and cards 8dp corners; a card a 3dp black edge. -->
    <style name="ShapeAppearance.Topo.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Widget.Topo.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="strokeColor">@android:color/black</item>
        <item name="strokeWidth">3dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Topo.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Topo.Small</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Topo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Topo.Small</item>
        <item name="strokeColor">@android:color/black</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.Topo.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@android:color/black</item>
        <item name="tint">@android:color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Topo.Small</item>
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Topo.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@android:color/black</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Topo.Small</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- The current tab is shown in bold, not by a grey pill: bold is the only emphasis -->
    <style name="Widget.Topo.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bottom_nav_background</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Topo.BottomNavigation.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Topo.NavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Topo.LabelMedium</item>
    </style>

    <style name="Widget.Topo.BottomNavigation.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.Topo.NavActive" parent="TextAppearance.Topo.LabelMedium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
